    {
      "relation_type": PEST DAMAGE_RELATIONSHIP,
      "source_entity_id": Silage_Corn,
      "target_entity_id": European_Corn_Borer,
      "fact": "European Corn Borers are a common pest of Silage corn, causing damage by boring into stalks and ears."
    },
    {
      "relation_type": GROWTH_STAGE_RELATIONSHIP,
      "source_entity_id": Seedling_Stage_Corn,
      "target_entity_id": Growth_Stage_V6,
      "fact": "After emergence, corn progress through growth stages including: V1 (one visible leaf) and V6 (six fully exposed leaves above the soil)."
    },
    {
      "relation_type": PLANTING_DATE_RELATIONSHIP,
      "source_entity_id": Spring_Plowing_Date,
      "target_entity_id": Soil_Preparation_Date,
      "fact": "In late spring, after the danger of frost has passed in a given area and after winter snows have thawed sufficiently for plowing, planting generally commences soon thereafter."
    },
    {
      "relation_type": WEATHER_IMPACT_RELATIONSHIP,
      "source_entity_id": Drought,
      "target_entity_id": Silage_Corn_Yield_Reduction,
      "fact": "Prolonged periods of dry conditions without sufficient rainfall result in yield reduction and diminished corn quality."
    },
